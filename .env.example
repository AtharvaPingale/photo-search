# Copy to .env. Everything has a default; only PHOTOS_DIR is required for Docker.

# ---- Docker Compose -----------------------------------------------------------
# Your photo library on the host (mounted at /photos in the containers).
PHOTOS_DIR=/home/you/Pictures
# Your phone's camera-roll backup folder (PhotoSync, Syncthing, ...). New files are
# copied into $PHOTOS_DIR/Imported/YYYY/YYYY-MM/ and indexed. Leave unset to skip.
# IMPORT_DIR=/home/you/PhoneBackup
POSTGRES_PASSWORD=photos
# Where thumbnails/face crops/fine-tuned models and nightly backups live on the host.
# DATA_DIR=./data
# BACKUPS_DIR=./backups
# 127.0.0.1 = this machine only (use Tailscale for your phone); 0.0.0.0 = your LAN too.
PS_BIND=127.0.0.1
# Host port for the web app / API (change if 8000 is taken).
PS_PORT=8000
# Nightly backup hour (container local time, 0-23).
BACKUP_HOUR=3
# Only for `docker compose --profile tailscale up`: an auth key from the Tailscale admin console.
# TS_AUTHKEY=tskey-auth-...

# ---- Access from your phone ------------------------------------------------------
# Required as soon as anything other than localhost can reach the API.
# Generate: `uv run photo-search token`. Pair a phone: `uv run photo-search pair https://<host>`.
PS_AUTH_TOKEN=

# ---- Native (no Docker) ------------------------------------------------------------
# PS_DATABASE_URL=postgresql://photos:photos@localhost:5432/photos
# PS_REDIS_URL=redis://localhost:6379/0
# PS_PHOTO_ROOTS=["/home/you/Pictures"]
# PS_IMPORT_DIRS=["/home/you/PhoneBackup"]
# PS_IMPORT_DEST=/home/you/Pictures/Imported
# PS_IMPORT_MODE=copy            # or move
# PS_DATA_DIR=./data             # thumbnails, face crops, fine-tuned models
# PS_BACKUPS_DIR=./backups
# PS_BACKUP_KEEP_DAYS=14

# ---- Privacy -------------------------------------------------------------------------
# Face detection is opt-in per folder; empty = never.
# PS_FACE_ROOTS=["/photos/Family"]

# ---- Models ----------------------------------------------------------------------------
# PS_DEVICE=auto                 # auto | cuda | mps | cpu
# PS_IMAGE_MODEL=openclip-vitb32 # or openclip-vitl14, or a fine-tuned name like finetuned-v1
# PS_TEXT_EMBED_MODEL=BAAI/bge-small-en-v1.5
# PS_CAPTION_BACKEND=florence2   # florence2 | qwen2vl | anthropic (sends thumbnails to the API!) | none
# PS_OCR_BACKEND=paddleocr       # paddleocr | florence2 | none
# PS_OCR_GATE_THRESHOLD=0.5

# ---- LLM (query parsing, album titles, agent) -------------------------------------------
# ollama keeps everything local. anthropic sends text only (queries, captions, metadata).
# PS_LLM_PROVIDER=ollama         # ollama | anthropic | none
# PS_LLM_MODEL=qwen2.5:14b-instruct
# PS_OLLAMA_URL=http://localhost:11434
# PS_ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# ---- Tracing / experiment tracking ---------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=photo-search
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
